            "senha": "admin123"
        },
        "statusCodeEsperado": 200
    },
    {
        "testTitle": "deve retornar 200 e um token quando o aluno informar e-mail e senha corretos",
        "dadosLogin": {
            "email": "ana.souza@example.com",
            "senha": "123456"
        },
        "statusCodeEsperado": 200
    },
    {
        "testTitle": "deve retornar 400 quando o e-mail não for informado",
        "dadosLogin": {
            "email": "",
            "senha": "admin123"
        },
        "statusCodeEsperado": 400,
        "mensagemEsperada": "Os campos \"email\" e \"senha\" são obrigatórios."
    },
    {
        "testTitle": "deve retornar 400 quando a senha não for informada",
        "dadosLogin": {
            "email": "admin@escola.com",
            "senha": ""
        },
