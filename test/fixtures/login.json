        },
        "statusCodeEsperado": 401,
        "mensagemEsperada": "E-mail ou senha inválidos."
    },
    {
        "testTitle": "deve retornar 401 quando o e-mail não estiver cadastrado",
        "dadosLogin": {
            "email": "nao.cadastrado@escola.com",
